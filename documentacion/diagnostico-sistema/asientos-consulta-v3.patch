+                ImpTotal = comprobante.ImpTotal,
+                Detalle = comprobante.Detalle,
+                Memo = comprobante.Memo
+            };
+
+            foreach (var linea in lineas)
+            {
+                var lineaEntidad = AsientoMapeo.AEntidad(linea);
+                lineaEntidad.ComprobanteId = null;
