+        private async Task<int> ReservarSiguienteNumero(int numeraTipoId)
+        {
+            const int intentosMaximos = 5;
+
+            for (var intento = 1; intento <= intentosMaximos; intento++)
+            {
+                var configuracion = await _contexto.NumeraTipos
+                    .AsNoTracking()
+                    .Where(item => item.Id == numeraTipoId)
+                    .Select(item => new
+                    {
+                        item.NumeracionId,
+                        NumeroActual = item.Numeracion == null ? null : item.Numeracion.Numero,
+                        NumeradorTipo = item.Numeracion == null ? null : item.Numeracion.NumeradorTipo
+                    })
+                    .SingleOrDefaultAsync();
+
+                ValidarNumeracionAutomatica(configuracion?.NumeracionId, configuracion?.NumeradorTipo, numeraTipoId);
+
+                var numeroActual = configuracion!.NumeroActual;
+                var siguienteNumero = checked((numeroActual ?? 0) + 1);
+                var filasActualizadas = await _contexto.Numeraciones
+                    .Where(item => item.Id == configuracion.NumeracionId!.Value && item.Numero == numeroActual)
+                    .ExecuteUpdateAsync(actualizacion => actualizacion
+                        .SetProperty(item => item.Numero, siguienteNumero));
+
+                if (filasActualizadas == 1)
+                {
+                    return siguienteNumero;
+                }
+            }
+
+            throw new InvalidOperationException(
+                $"No se pudo reservar un número para NumeraTipoID {numeraTipoId} después de {intentosMaximos} intentos concurrentes.");
+        }
+
+        private async Task<int> ReservarSiguienteNumeroEnMemoria(int numeraTipoId)
+        {
+            var numeraTipo = await _contexto.NumeraTipos
+                .Include(item => item.Numeracion)
+                .SingleOrDefaultAsync(item => item.Id == numeraTipoId);
+
+            ValidarNumeracionAutomatica(
+                numeraTipo?.NumeracionId,
+                numeraTipo?.Numeracion?.NumeradorTipo,
+                numeraTipoId);
+
+            var siguienteNumero = checked((numeraTipo!.Numeracion!.Numero ?? 0) + 1);
+            numeraTipo.Numeracion.Numero = siguienteNumero;
+            return siguienteNumero;
+        }
